{
  "name": "johood-macro",
  "version": "1.0.3",
  "description": "JoHood Fortnite Macro - تطبيق فورت نايت",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.johood.macro",
    "productName": "JoHood Macro",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JoHood Macro"
    },
    "portable": {
      "artifactName": "JoHood_Macro_Portable.exe"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "nsschooI",
      "repo": "johood-dashboard"
    }
  },
  "author": "JoHood",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7"
  }
}
