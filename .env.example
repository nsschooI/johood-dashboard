# JoHood Dashboard — environment variables.
# Copy to .env.local (dev) or .env.production (server) and fill in.
# NEVER commit a filled-in copy: .env* files are git-ignored.

# --- App -------------------------------------------------------------------
# Public URL the dashboard is served from (used for OAuth redirects,
# origin checks and the Secure cookie flag when it starts with https://).
APP_URL=http://localhost:3000
# Where SQLite keeps sessions, the audit log and preferences.
DATA_DIR=./data
# Set to true when running behind nginx/caddy so client IPs in the audit
# log come from X-Forwarded-For. Leave false when exposed directly.
TRUST_PROXY=false
# Zone used for "today" and daily/weekly chart buckets.
NEXT_PUBLIC_DASHBOARD_TIMEZONE=Asia/Amman

# --- Discord OAuth2 --------------------------------------------------------
# Discord Developer Portal → your application → OAuth2.
# Add "${APP_URL}/api/auth/callback" as a redirect URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The JoHood server (guild) ID. Staff roles are read from this guild.
DISCORD_GUILD_ID=
# Optional override; defaults to ${APP_URL}/api/auth/callback
DISCORD_REDIRECT_URI=

# --- Data provider ---------------------------------------------------------
# "mock" = built-in simulated data (default). "real" = the bot backend.
PROVIDER=mock
# Only used when PROVIDER=real. Keep the backend on localhost / a private
# network; see docs/provider-api.md.
PROVIDER_API_URL=http://127.0.0.1:8787
PROVIDER_API_TOKEN=

# --- Development login -----------------------------------------------------
# Lets you sign in as any role without Discord. Never on a public server.
MOCK_LOGIN=false
# Mock login is refused when NODE_ENV=production unless this is also true
# (only for a private staging box).
ALLOW_MOCK_LOGIN_IN_PRODUCTION=false
# Mock only: answer every action with 501 "not implemented", like the real
# backend while actions are still being built — to preview that UX.
MOCK_NOT_IMPLEMENTED=false
